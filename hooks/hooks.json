{
  "description": "In a session holding an Anderton role, the repository's or a project's, wakes it when a session it answers for blocks on a person. Holds a message to an Anderton, from its workers or another session in the repository, that names no kind or repeats the last one sent; records a message once it is sent. Neither hook can approve anything.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/watch.sh\"",
            "asyncRewake": true,
            "timeout": 1209600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/report-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/anderton/scripts/report-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
